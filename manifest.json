{
  "manifest_version": 3,
  "name": "NFS-e Automático",
  "description": "Preenche Pessoas e Serviço no Emissor Nacional da NFS-e.",
  "version": "0.4.3",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.nfse.gov.br/EmissorNacional/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "NFS-e Automático",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nfse.gov.br/EmissorNacional/DPS/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "minimum_chrome_version": "141"
}
