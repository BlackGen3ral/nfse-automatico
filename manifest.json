{
  "manifest_version": 3,
  "name": "NFS-e Automático",
  "description": "Preenche campos configurados localmente no Emissor Nacional da NFS-e.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": ["https://www.nfse.gov.br/EmissorNacional/*"],
  "action": {
    "default_title": "NFS-e Automático",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.nfse.gov.br/EmissorNacional/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

